# >>> secrets: never commit real keys <<<
# Copy to .env and fill in. App runs fully offline without any key (stub provider).

# LLM provider: stub | openai_compatible
AFROMEDX_LLM_PROVIDER=stub

# For openai_compatible (OpenAI or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Retrieval tuning
AFROMEDX_TOP_K=6
AFROMEDX_MIN_SCORE=0.08
AFROMEDX_SEMANTIC_WEIGHT=0.65

# Paths
AFROMEDX_INDEX_DIR=./data/index
AFROMEDX_GUIDELINE_DIR=./data/guidelines

# Optional: force TF-IDF even if sentence-transformers installed
AFROMEDX_FORCE_TFIDF=0
