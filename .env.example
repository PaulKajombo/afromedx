# >>> secrets: never commit real keys <<<
# Copy to .env and fill in. App runs fully offline without any key (stub provider).

# LLM provider: stub | gemini | mistral | openai_compatible
AFROMEDX_LLM_PROVIDER=stub

# For gemini (native provider via the official google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY=1.0

# For mistral (native provider via the official mistralai SDK)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
MISTRAL_TEMPERATURE=0.0
MISTRAL_TIMEOUT=60
MISTRAL_MAX_RETRIES=2
MISTRAL_RETRY_BASE_DELAY=1.0

# For openai_compatible (OpenAI or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Retrieval tuning (validated 2026-09-21: SBERT all-MiniLM-L6-v2, 13,072 chunks)
AFROMEDX_TOP_K=6
AFROMEDX_MIN_SCORE=0.08
AFROMEDX_SEMANTIC_WEIGHT=0.65
# P1A: section/subsection/document-title weight inside the keyword arm (0 disables)
AFROMEDX_SECTION_WEIGHT=0.35
# P1B: clinical abbreviation synonyms VL/TLD/verb-forms (1 on, 0 off for ablation)
AFROMEDX_CLINICAL_SYNONYMS=1
# P1C: max chunks per document in top-K (0 disables)
AFROMEDX_MAX_PER_DOC=2
# P1D: collapse text-identical chunks across doc ids, keep best (1 on, 0 off)
AFROMEDX_DEDUP_COLLAPSE=1
# Edition policy: superseded docs never retrieved (comma list); recency bonus
# favouring newer editions, 0 disables
AFROMEDX_EXCLUDE_DOCS=paediatrics-handbook,obgyn
AFROMEDX_RECENCY_WEIGHT=0.02
# Answer cache TTL in seconds (repeat questions skip retrieval + LLM); 0 disables
AFROMEDX_CACHE_TTL=600

# Paths
AFROMEDX_INDEX_DIR=./data/index
AFROMEDX_GUIDELINE_DIR=./data/guidelines

# Optional: force TF-IDF even if sentence-transformers installed
AFROMEDX_FORCE_TFIDF=0
